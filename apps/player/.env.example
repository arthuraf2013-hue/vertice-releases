# Copie para .env e preencha com o projeto Firebase do Vértice
# (Console do Firebase › Configurações do projeto › Seus apps › App da Web).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=vertice-xxxx.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=vertice-xxxx
VITE_FIREBASE_STORAGE_BUCKET=vertice-xxxx.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# 1 = usa os emuladores locais (npm run emulators)
VITE_FIREBASE_EMULATOR=0
# Chave do Open-Meteo (clima, chuva, qualidade do ar, sol). O uso gratuito é só para fins não comerciais;
# para vender o Vértice, contrate um plano em open-meteo.com e coloque a chave aqui (e no secret do GitHub).
VITE_OPEN_METEO_KEY=

# Pasta do Google Drive (opcional): chave da API do Google para listar a pasta. Sem ela, a TV lê a página pública da pasta.
VITE_GOOGLE_API_KEY=
