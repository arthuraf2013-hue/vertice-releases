{
  "name": "@vertice/panel",
  "productName": "Vértice",
  "version": "0.2.0",
  "private": true,
  "description": "Painel de gestão do Vértice (web e desktop)",
  "author": "Vetta Sistemas",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:demo": "vite --mode demo",
    "build": "vite build",
    "build:demo": "vite build --mode demo",
    "preview": "vite preview",
    "electron:dev": "cross-env VERTICE_DEV_URL=http://localhost:5173 electron .",
    "electron:build": "vite build && electron-builder --win --publish never"
  },
  "dependencies": {
    "@vertice/shared": "*",
    "firebase": "^13.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.2.1",
    "cross-env": "^10.0.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "vite": "^8.3.6"
  },
  "build": {
    "appId": "br.com.vettasistemas.vertice",
    "productName": "Vértice",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Vertice-Painel-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Vértice"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    },
    "electronVersion": "45.2.3",
    "publish": null
  }
}
