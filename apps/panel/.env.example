# Copie para .env e preencha com o projeto Firebase do Vértice
# (Console do Firebase › Configurações do projeto › Seus apps › App da Web).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=vertice-xxxx.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=vertice-xxxx
VITE_FIREBASE_STORAGE_BUCKET=vertice-xxxx.firebasestorage.app
# Servidor de mídias próprio (servers/media). Com ele preenchido, o Firebase Storage não é usado.
# Teste no mesmo PC: http://localhost:8787
VITE_MEDIA_SERVER_URL=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# 1 = usa os emuladores locais (npm run emulators)
VITE_FIREBASE_EMULATOR=0
# Links da página Downloads e WhatsApp comercial (só números, com DDI: 5581...)
VITE_DOWNLOAD_ANDROID=https://vertice.vettasistemas.com.br/downloads/vertice-player.apk
VITE_PLAYER_WEB_URL=https://vertice.vettasistemas.com.br/tv/
VITE_DOWNLOAD_WINDOWS=https://vertice.vettasistemas.com.br/downloads/vertice-painel-setup.exe
VITE_SUPPORT_WHATSAPP=
