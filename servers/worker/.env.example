# Copie para .env e preencha.
FIREBASE_PROJECT_ID=vertice-7ffa0
# Conta de serviço: console do Firebase › Configurações do projeto › Contas de serviço › Gerar nova chave privada.
# Guarde o arquivo só neste servidor (ele dá acesso total ao banco).
GOOGLE_APPLICATION_CREDENTIALS=./conta-de-servico.json
# Fuso das lojas (horário de silêncio e resumo das 8h).
TZ_LOJAS=America/Recife
PANEL_URL=https://vertice.vettasistemas.com.br/app/
# Resumo diário dos clientes para a Vetta.
VETTA_EMAIL=

# E-mail (SMTP de um provedor transacional: Brevo, Amazon SES, Mailgun, Zoho, Gmail com senha de app...)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Vértice <alertas@vettasistemas.com.br>"

# WhatsApp (opcional): zapi | evolution | webhook
WHATSAPP_PROVIDER=
ZAPI_INSTANCE=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=
EVOLUTION_URL=
EVOLUTION_INSTANCE=
EVOLUTION_APIKEY=
WHATSAPP_WEBHOOK_URL=
WHATSAPP_WEBHOOK_TOKEN=
