# Copie para .env e preencha.
FIREBASE_PROJECT_ID=vertice-xxxx
# Endereço pelo qual o painel e as TVs acessam este servidor (com https em produção).
PUBLIC_URL=https://midias.seudominio.com.br
PORT=8787
DATA_DIR=./data
MAX_UPLOAD_MB=500
# Origens do painel separadas por vírgula (ex.: https://vertice-xxxx.web.app,app://vertice). * libera todas.
ALLOWED_ORIGINS=*
