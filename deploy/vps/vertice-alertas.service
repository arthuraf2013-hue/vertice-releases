[Unit]
Description=Vértice - alertas de TV fora do ar e avisos de cobrança
After=network-online.target
Wants=network-online.target

[Service]
User=vertice
Group=vertice
WorkingDirectory=/opt/vertice/alertas
EnvironmentFile=/etc/vertice/alertas.env
ExecStart=@NODE@ worker.js
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
