rules_version = '2';

// Vértice — regras do Firestore.
// Três tipos de quem acessa:
//  1. Pessoas do painel: membros da empresa, com papel viewer < editor < admin < owner.
//  2. TVs: usuário anônimo pareado por código (devices/{uid}, kind "screen").
//  3. Integrações (GerenciaAI): usuário anônimo pareado por código (kind "integration").
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function memberDoc(cid) { return /databases/$(database)/documents/companies/$(cid)/members/$(uid()); }
    function isMember(cid) { return signedIn() && exists(memberDoc(cid)); }
    function rank(r) { return r == 'owner' ? 3 : (r == 'admin' ? 2 : (r == 'editor' ? 1 : 0)); }
    function hasRole(cid, min) { return isMember(cid) && rank(get(memberDoc(cid)).data.role) >= rank(min); }

    function deviceDoc() { return /databases/$(database)/documents/devices/$(uid()); }
    function isDevice(cid) { return signedIn() && exists(deviceDoc()) && get(deviceDoc()).data.companyId == cid; }
    function isScreen(cid, sid) { return isDevice(cid) && get(deviceDoc()).data.kind == 'screen' && get(deviceDoc()).data.targetId == sid; }
    function isAnyScreen(cid) { return isDevice(cid) && get(deviceDoc()).data.kind == 'screen'; }
    function isIntegration(cid) { return isDevice(cid) && get(deviceDoc()).data.kind == 'integration'; }

    function changesOnly(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }

    // ---------- Vetta Sistemas (console interno) ----------
    // Quem tem platformAdmins/{uid} administra todas as empresas. O documento é criado à mão no console do Firebase.
    function isVetta() { return signedIn() && exists(/databases/$(database)/documents/platformAdmins/$(uid())); }
    function settingsPath() { return /databases/$(database)/documents/platform/settings; }

    // ---------- Licença (mesma conta de packages/shared/src/license.js) ----------
    function companyData(cid) { return get(/databases/$(database)/documents/companies/$(cid)).data; }
    function licenseOk(c) {
      let st = c.get('status', 'active');
      return (st == 'active'
                && (c.get('paidUntil', null) == null
                    || c.paidUntil + duration.value(c.get('graceDays', 5), 'd') > request.time))
          || (st == 'trial' && c.get('trialEndsAt', null) != null && c.trialEndsAt > request.time);
    }
    function licensed(cid) { return licenseOk(companyData(cid)); }
    function authEmail() { return request.auth.token.email.lower(); }

    // ---------- Plataforma ----------
    // Configurações gerais (cadastro aberto, dias de teste, contato). Leitura pública: a tela de cadastro usa.
    match /platform/{docId} {
      allow get: if true;
      allow write: if isVetta();
    }
    match /platformAdmins/{adminUid} {
      allow get: if signedIn() && uid() == adminUid;
      allow list: if isVetta();
      allow write: if false;
    }

    // ---------- Perfil: liga o usuário à empresa ----------
    match /users/{userId} {
      allow get: if signedIn() && uid() == userId;
      // Só cria o próprio perfil, e só se o vínculo de membro existir ao fim do mesmo lote.
      allow create, update: if signedIn() && uid() == userId
        && existsAfter(/databases/$(database)/documents/companies/$(request.resource.data.companyId)/members/$(uid()));
      allow delete: if hasRole(resource.data.companyId, 'owner');
    }

    // ---------- Convites (id = e-mail em minúsculas) ----------
    match /invites/{email} {
      allow get: if signedIn() && (authEmail() == email || hasRole(resource.data.companyId, 'admin') || isVetta());
      allow list: if hasRole(resource.data.companyId, 'admin') || isVetta();
      allow create, update: if (hasRole(request.resource.data.companyId, 'admin')
          && request.resource.data.role in ['viewer', 'editor', 'admin'])
        // A Vetta cria a empresa do cliente e convida o dono.
        || (isVetta() && request.resource.data.role in ['viewer', 'editor', 'admin', 'owner']);
      allow delete: if signedIn() && (authEmail() == email || hasRole(resource.data.companyId, 'admin') || isVetta());
    }

    // ---------- Pareamento por código ----------
    match /pairings/{code} {
      // Quem tem o código pode ler (é o que o painel digita). Listar, nunca.
      allow get: if signedIn();
      // A TV/integração cria o próprio código. Se o código já existe, isto vira "update"
      // e é recusado: a TV tenta outro.
      allow create: if signedIn()
        && request.resource.data.uid == uid()
        && request.resource.data.code == code
        && code.size() == 6
        && request.resource.data.claimed == false
        && request.resource.data.kind in ['screen', 'integration']
        && request.resource.data.expiresAt <= request.time + duration.value(31, 'm');
      // Um admin da empresa reivindica um código válido.
      allow update: if resource.data.claimed == false
        && resource.data.expiresAt > request.time
        && request.resource.data.claimed == true
        && hasRole(request.resource.data.companyId, 'admin')
        && changesOnly(['claimed', 'companyId', 'targetId', 'companyName', 'claimedAt']);
      allow delete: if signedIn() && resource.data.uid == uid();
    }

    // ---------- Aparelhos pareados ----------
    match /devices/{deviceUid} {
      allow get: if signedIn() && (uid() == deviceUid || hasRole(resource.data.companyId, 'admin'));
      // Só nasce junto com a reivindicação de um código daquele mesmo aparelho.
      allow create: if hasRole(request.resource.data.companyId, 'admin')
        && request.resource.data.kind in ['screen', 'integration']
        && getAfter(/databases/$(database)/documents/pairings/$(request.resource.data.pairingCode)).data.uid == deviceUid
        && getAfter(/databases/$(database)/documents/pairings/$(request.resource.data.pairingCode)).data.companyId == request.resource.data.companyId
        && getAfter(/databases/$(database)/documents/pairings/$(request.resource.data.pairingCode)).data.kind == request.resource.data.kind;
      allow delete: if hasRole(resource.data.companyId, 'admin');
    }

    // ---------- Empresa ----------
    match /companies/{cid} {
      allow get: if isMember(cid) || isVetta();
      allow list: if isVetta();
      // Cadastro aberto: conta nova cria a própria empresa no plano Start, em teste grátis.
      // Plano, limites, vencimento e situação só mudam pela Vetta (console interno ou Admin SDK).
      allow create: if isVetta() || (signedIn()
        && (!exists(settingsPath()) || get(settingsPath()).data.get('signupOpen', true) == true)
        && request.resource.data.keys().hasOnly(['name', 'ownerUid', 'ownerEmail', 'plan', 'screenLimit', 'storageQuotaMB',
             'storageUsedBytes', 'screenSeq', 'screenCount', 'status', 'trialEndsAt', 'createdAt', 'phone', 'city', 'source', 'referredBy'])
        && request.resource.data.get('referredBy', '') is string && request.resource.data.get('referredBy', '').size() <= 12
        && request.resource.data.ownerUid == uid()
        && request.resource.data.plan == 'start'
        && request.resource.data.screenLimit == 3
        && request.resource.data.storageQuotaMB == 1024
        && request.resource.data.storageUsedBytes == 0
        && request.resource.data.screenSeq == 0
        && request.resource.data.screenCount == 0
        && request.resource.data.status == 'trial'
        && request.resource.data.trialEndsAt > request.time
        && request.resource.data.trialEndsAt <= request.time + duration.value(
             (exists(settingsPath()) ? get(settingsPath()).data.get('trialDays', 14) : 14) + 1, 'd'));
      allow update: if isVetta()
        || (hasRole(cid, 'admin') && changesOnly(['name', 'cnpj', 'phone', 'city', 'screenSeq', 'alerts', 'hours', 'catalog']))
        // Alerta urgente: quem edita conteúdo também pode mandar e encerrar.
        || (hasRole(cid, 'editor') && changesOnly(['alert']) && request.resource.data.alert is map)
        || (hasRole(cid, 'editor') && changesOnly(['storageUsedBytes']))
        // Contador de telas: só muda junto com a criação ou a exclusão daquela tela (screenOp = id dela),
        // e nunca passa do limite do plano.
        || (hasRole(cid, 'admin') && changesOnly(['screenSeq', 'screenCount', 'screenOp'])
            && request.resource.data.screenOp is string
            && ((request.resource.data.screenCount == resource.data.get('screenCount', 0) + 1
                  && request.resource.data.screenCount <= resource.data.get('screenLimit', 1000)
                  && licenseOk(resource.data)
                  && !exists(/databases/$(database)/documents/companies/$(cid)/screens/$(request.resource.data.screenOp))
                  && existsAfter(/databases/$(database)/documents/companies/$(cid)/screens/$(request.resource.data.screenOp)))
              || (request.resource.data.screenCount == resource.data.get('screenCount', 0) - 1
                  && request.resource.data.screenCount >= 0
                  && exists(/databases/$(database)/documents/companies/$(cid)/screens/$(request.resource.data.screenOp))
                  && !existsAfter(/databases/$(database)/documents/companies/$(cid)/screens/$(request.resource.data.screenOp)))));

      // Pagamentos registrados pela Vetta. O dono e os administradores veem o histórico.
      match /payments/{pid} {
        allow read: if hasRole(cid, 'admin') || isVetta();
        allow write: if isVetta();
      }
      // Avisos enviados pelo serviço de alertas (servers/worker, Admin SDK).
      match /alertLog/{lid} {
        allow read: if isMember(cid) || isVetta();
        allow write: if false;
      }
      // Teste de alerta: o admin pede, o serviço de alertas envia e apaga.
      match /alertTests/{tid} {
        allow read: if hasRole(cid, 'admin');
        allow create: if hasRole(cid, 'admin')
          && request.resource.data.keys().hasOnly(['at', 'by'])
          && request.resource.data.at == request.time;
        allow delete: if hasRole(cid, 'admin');
      }

      match /members/{memberUid} {
        allow read: if isMember(cid) || isVetta();
        allow create: if signedIn() && memberUid == uid() && (
          // Dono criando a própria empresa no mesmo lote.
          (request.resource.data.role == 'owner' && getAfter(/databases/$(database)/documents/companies/$(cid)).data.ownerUid == uid())
          // Ou aceitando um convite desta empresa, com o papel do convite.
          || (exists(/databases/$(database)/documents/invites/$(authEmail()))
              && get(/databases/$(database)/documents/invites/$(authEmail())).data.companyId == cid
              && get(/databases/$(database)/documents/invites/$(authEmail())).data.role == request.resource.data.role)
        );
        allow update: if hasRole(cid, 'owner') && memberUid != uid()
          && request.resource.data.role in ['viewer', 'editor', 'admin'] && changesOnly(['role']);
        allow delete: if hasRole(cid, 'owner') && memberUid != uid();
      }

      match /units/{id} {
        allow read: if isMember(cid);
        allow write: if hasRole(cid, 'admin');
      }
      match /groups/{id} {
        allow read: if isMember(cid);
        allow write: if hasRole(cid, 'admin');
      }
      match /media/{id} {
        allow read: if isMember(cid);
        allow write: if hasRole(cid, 'editor');
      }
      match /playlists/{id} {
        allow read: if isMember(cid);
        allow write: if hasRole(cid, 'editor');
      }
      match /schedules/{id} {
        allow read: if isMember(cid);
        allow write: if hasRole(cid, 'editor');
      }
      // Anunciantes (relatório de comprovação de exibição).
      match /advertisers/{id} {
        allow read: if isMember(cid);
        allow write: if hasRole(cid, 'editor');
      }

      // Video walls: grupo de telas formando uma imagem só. O painel compila no manifesto de cada tela.
      // Layouts em zonas e barra inferior.
      match /layouts/{id} {
        allow read: if isMember(cid);
        allow write: if hasRole(cid, 'editor');
      }

      // Propostas de mídia indoor (comercial).
      match /proposals/{id} {
        allow read: if isMember(cid);
        allow write: if hasRole(cid, 'editor');
      }

      // Registro de atividades: cada pessoa grava o próprio registro; ninguém altera nem apaga.
      match /audit/{id} {
        allow read: if hasRole(cid, 'admin');
        allow create: if isMember(cid)
          && request.resource.data.keys().hasOnly(['action', 'area', 'targetId', 'targetName', 'fields', 'uid', 'byName', 'at'])
          && request.resource.data.uid == uid()
          && request.resource.data.at == request.time
          && request.resource.data.area is string && request.resource.data.area.size() <= 80
          && request.resource.data.get('targetName', '') is string && request.resource.data.get('targetName', '').size() <= 80
          && request.resource.data.byName is string && request.resource.data.byName.size() <= 80;
        allow update, delete: if false;
      }

      // Chamada de senhas: qualquer pessoa da empresa (inclusive "visualizador", ex.: recepção) chama.
      match /queues/{qid} {
        allow read: if isMember(cid) || (isAnyScreen(cid) && licensed(cid));
        allow create, delete: if hasRole(cid, 'editor');
        allow update: if hasRole(cid, 'editor')
          || (isMember(cid) && changesOnly(['seq', 'current', 'history', 'updatedAt'])
              && request.resource.data.history is list && request.resource.data.history.size() <= 6);
      }

      // Cronômetro: qualquer pessoa da empresa inicia, pausa e zera.
      match /timers/{tid} {
        allow read: if isMember(cid) || (isAnyScreen(cid) && licensed(cid));
        allow create, delete: if hasRole(cid, 'editor');
        allow update: if hasRole(cid, 'editor')
          || (isMember(cid) && changesOnly(['status', 'startedAt', 'pausedAt', 'pausedMs', 'updatedAt'])
              && request.resource.data.status in ['running', 'paused', 'stopped']);
      }

      // Enquete: pergunta pública; um voto por aparelho e por rodada; o placar sobe 1 no mesmo lote.
      match /polls/{pid} {
        allow get: if true;
        allow list: if isMember(cid);
        allow create, update: if hasRole(cid, 'editor')
          && request.resource.data.keys().hasOnly(['question', 'options', 'open', 'round', 'companyName', 'theme', 'updatedAt'])
          && request.resource.data.question is string && request.resource.data.question.size() <= 120
          && request.resource.data.options is list && request.resource.data.options.size() >= 2 && request.resource.data.options.size() <= 6
          && request.resource.data.round is int;
        allow delete: if hasRole(cid, 'editor');

        match /votes/{vid} {
          function pollData() { return get(/databases/$(database)/documents/companies/$(cid)/polls/$(pid)).data; }
          function tallyPath() { return /databases/$(database)/documents/companies/$(cid)/pollTallies/$(pid); }
          allow read: if isMember(cid);
          allow create: if signedIn()
            && vid == string(pollData().round) + '_' + uid()
            && request.resource.data.keys().hasOnly(['option', 'at'])
            && request.resource.data.at == request.time
            && request.resource.data.option is int
            && request.resource.data.option >= 0 && request.resource.data.option < pollData().options.size()
            && pollData().get('open', false) == true
            && getAfter(tallyPath()).data.total == get(tallyPath()).data.get('total', 0) + 1
            && licensed(cid);
          allow delete: if hasRole(cid, 'editor');
        }
      }
      // Pesquisa de satisfação: questionário público; uma resposta por aparelho e por rodada.
      match /surveys/{sid} {
        allow get: if true;
        allow list: if isMember(cid);
        allow create, update: if hasRole(cid, 'editor')
          && request.resource.data.keys().hasOnly(['title', 'questions', 'open', 'round', 'companyName', 'theme', 'updatedAt'])
          && request.resource.data.questions is list && request.resource.data.questions.size() >= 1 && request.resource.data.questions.size() <= 8
          && request.resource.data.round is int;
        allow delete: if hasRole(cid, 'editor');

        match /responses/{rid} {
          function sv() { return get(/databases/$(database)/documents/companies/$(cid)/surveys/$(sid)).data; }
          function okA(a, k) {
            return !(k in a) || (a[k] is int && a[k] >= 0 && a[k] <= 10) || (a[k] is string && a[k].size() > 0 && a[k].size() <= 500);
          }
          function okAnswers(a) {
            return a is map && a.size() >= 1
              && a.keys().hasOnly(['q0', 'q1', 'q2', 'q3', 'q4', 'q5', 'q6', 'q7'])
              && okA(a, 'q0') && okA(a, 'q1') && okA(a, 'q2') && okA(a, 'q3') && okA(a, 'q4') && okA(a, 'q5') && okA(a, 'q6') && okA(a, 'q7');
          }
          allow read: if hasRole(cid, 'editor');
          allow create: if signedIn()
            && rid == string(sv().round) + '_' + uid()
            && request.resource.data.keys().hasOnly(['answers', 'at'])
            && request.resource.data.at == request.time
            && okAnswers(request.resource.data.answers)
            && sv().get('open', false) == true
            && licensed(cid);
          allow update: if false;
          allow delete: if hasRole(cid, 'editor');
        }
      }

      // CRM de anunciantes e clientes: só a equipe da empresa.
      match /leads/{id} {
        allow read: if isMember(cid);
        allow write: if hasRole(cid, 'editor');
      }

      // Faturas: o dono e os administradores veem as suas; quem cria e dá baixa é a Vetta
      // (console ou servidor, que também gera a cobrança no Asaas).
      match /invoices/{iid} {
        allow read: if hasRole(cid, 'admin') || isVetta();
        allow write: if isVetta();
      }

      // Pedidos da Loja: a empresa vê os seus; quem cria e confirma é o servidor (Asaas).
      match /storeOrders/{id} {
        allow read: if hasRole(cid, 'admin') || isVetta();
        allow write: if false;
      }

      match /pollTallies/{pid} {
        function voteAfter() {
          return /databases/$(database)/documents/companies/$(cid)/polls/$(pid)/votes/$(string(resource.data.round) + '_' + uid());
        }
        function okVote() {
          let k = 'o' + string(getAfter(voteAfter()).data.option);
          return signedIn()
            && !exists(voteAfter()) && existsAfter(voteAfter())
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['counts', 'total'])
            && request.resource.data.total == resource.data.get('total', 0) + 1
            && request.resource.data.counts.diff(resource.data.get('counts', {})).affectedKeys().hasOnly([k])
            && request.resource.data.counts[k] == resource.data.get('counts', {}).get(k, 0) + 1;
        }
        allow get: if true;
        allow create: if hasRole(cid, 'editor');
        allow update: if hasRole(cid, 'editor') || okVote();
        allow delete: if hasRole(cid, 'editor');
      }

      match /videowalls/{id} {
        allow read: if isMember(cid);
        allow write: if hasRole(cid, 'editor');
      }

      // Tabelas de preço (Price). A TV recebe os preços já dentro do manifesto.
      match /priceLists/{id} {
        allow read: if isMember(cid);
        allow write: if hasRole(cid, 'editor');
      }

      // Exibições do dia por tela (Relatórios). Id = "{tela}_{AAAA-MM-DD}"; a TV grava os totais do dia.
      match /playStats/{id} {
        function okStats() {
          let d = request.resource.data;
          return isScreen(cid, d.screenId)
            && d.keys().hasOnly(['screenId', 'date', 'items', 'updatedAt'])
            && d.date is string && d.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
            && id == d.screenId + '_' + d.date
            && d.items is map && d.items.size() <= 400
            && d.updatedAt == request.time;
        }
        allow read: if isMember(cid);
        allow create: if okStats();
        allow update: if okStats() && resource.data.screenId == request.resource.data.screenId;
        allow delete: if hasRole(cid, 'owner');
      }

      // O que cada TV toca, compilado pelo painel. A TV lê só o dela.
      // Com a licença bloqueada, a TV deixa de receber e o painel deixa de publicar.
      match /manifests/{sid} {
        allow read: if isMember(cid) || (isScreen(cid, sid) && licensed(cid));
        allow create, update: if hasRole(cid, 'editor') && licensed(cid);
        allow delete: if hasRole(cid, 'editor');
      }

      match /screens/{sid} {
        allow read: if isMember(cid) || isScreen(cid, sid) || isVetta();
        // Tela nova só junto com o contador da empresa (que confere o limite do plano).
        allow create: if hasRole(cid, 'admin')
          && getAfter(/databases/$(database)/documents/companies/$(cid)).data.get('screenOp', '') == sid
          && getAfter(/databases/$(database)/documents/companies/$(cid)).data.get('screenCount', 0)
               == companyData(cid).get('screenCount', 0) + 1;
        allow delete: if isVetta() || (hasRole(cid, 'admin')
          && (companyData(cid).get('screenCount', 0) == 0
              || getAfter(/databases/$(database)/documents/companies/$(cid)).data.get('screenCount', 0)
                   == companyData(cid).get('screenCount', 0) - 1));
        // A TV só atualiza o próprio sinal de vida, com o horário do servidor.
        allow update: if hasRole(cid, 'admin')
          || (isScreen(cid, sid)
              && changesOnly(['lastSeen', 'appVersion', 'platform', 'model', 'resolution', 'nowPlaying', 'syncState'])
              && request.resource.data.lastSeen == request.time);

        // Controle remoto: o painel manda um comando (live/command); a TV responde com o
        // diagnóstico (live/diagnostics, com a resposta em "ack") e a foto da tela (live/screenshot).
        match /live/{name} {
          function d() { return request.resource.data; }
          allow read: if isMember(cid) || isScreen(cid, sid);
          allow create, update: if (
              name == 'command' && hasRole(cid, 'admin')
              && d().keys().hasOnly(['id', 'type', 'at', 'by'])
              && d().id is string && d().id.size() <= 40
              && d().type in ['identify', 'menu', 'reload', 'restart', 'update', 'screenshot', 'diagnostics']
              && d().at == request.time
            ) || (
              name == 'diagnostics' && isScreen(cid, sid)
              && d().keys().hasOnly(['at', 'appVersion', 'nativeVersion', 'shell', 'platform', 'model', 'resolution',
                                     'uptimeMin', 'online', 'networkType', 'latency', 'storage', 'sync', 'phase',
                                     'update', 'errors', 'ack'])
              && d().at == request.time
            ) || (
              name == 'screenshot' && isScreen(cid, sid)
              && d().keys().hasOnly(['at', 'image'])
              && d().image is string && d().image.size() < 900000 && d().image.matches('data:image/jpeg;base64,.*')
              && d().at == request.time
            );
          allow delete: if hasRole(cid, 'admin');
        }

        // Histórico de fotos da tela (Capturas). A TV guarda as últimas e apaga as antigas.
        match /captures/{capId} {
          allow read: if isMember(cid) || isScreen(cid, sid);
          allow create: if isScreen(cid, sid)
            && request.resource.data.keys().hasOnly(['image', 'at'])
            && request.resource.data.image is string && request.resource.data.image.size() < 900000
            && request.resource.data.image.matches('data:image/jpeg;base64,.*')
            && request.resource.data.at == request.time;
          allow delete: if isScreen(cid, sid) || hasRole(cid, 'admin');
        }
      }

      // ---------- Mural de comentários (app "comments"; id do mural = id da mídia do app) ----------
      // Mural: título e pergunta. Leitura pública (a página de envio, aberta pelo QR, mostra).
      match /commentBoards/{bid} {
        allow get: if true;
        allow list: if isMember(cid);
        allow create, update: if hasRole(cid, 'editor')
          && request.resource.data.keys().hasOnly(['title', 'question', 'open', 'autoApprove', 'companyName', 'theme', 'kind', 'updatedAt'])
          && request.resource.data.get('kind', 'comments') in ['comments', 'photos']
          && request.resource.data.title is string && request.resource.data.title.size() <= 60
          && request.resource.data.question is string && request.resource.data.question.size() <= 140
          && request.resource.data.open is bool;
        allow delete: if hasRole(cid, 'editor');

        // Comentários. Quem envia é um usuário anônimo da página pública; nunca lê o que mandou.
        // A TV só lê os aprovados; a equipe lê todos e modera.
        match /comments/{commentId} {
          function boardData() { return get(/databases/$(database)/documents/companies/$(cid)/commentBoards/$(bid)).data; }
          function settings() { return get(/databases/$(database)/documents/companies/$(cid)/commentSettings/$(bid)).data; }
          function limitAfter() { return getAfter(/databases/$(database)/documents/commentLimits/$(uid())).data; }
          function newComment() {
            let d = request.resource.data;
            let pattern = settings().get('blockPattern', 'a^');
            let photos = boardData().get('kind', 'comments') == 'photos';
            return signedIn()
              && d.keys().hasOnly(['name', 'text', 'status', 'createdAt', 'uid', 'photo'])
              && d.uid == uid()
              && d.createdAt == request.time
              && d.text is string && d.text.size() <= 200
              // Mural de fotos: a foto é obrigatória e precisa ser deste mural (enviada pelo servidor de mídias).
              && (photos
                  ? (d.get('photo', null) is string && d.photo.size() <= 300
                     && d.photo.matches('https?://[^/]+/m/' + cid + '/p-' + bid + '-[A-Za-z0-9_-]+[.]jpg'))
                  : (!('photo' in d) && d.text.size() >= 2))
              && d.name is string && d.name.size() <= 30
              && boardData().get('open', false) == true
              // Limite por aparelho: o contador (commentLimits) muda no mesmo lote e aponta para este comentário.
              && limitAfter().lastAt == request.time
              && limitAfter().lastId == commentId
              // Aprovado direto só com aprovação automática ligada e sem palavra bloqueada.
              && (d.status == 'pending'
                  || (d.status == 'approved' && settings().get('autoApprove', false) == true
                      && !d.text.lower().matches(pattern) && !d.name.lower().matches(pattern)))
              && licensed(cid);
          }
          allow read: if isMember(cid) || (isAnyScreen(cid) && resource.data.status == 'approved' && licensed(cid));
          allow create: if newComment();
          allow update: if hasRole(cid, 'editor')
            && changesOnly(['status', 'moderatedAt'])
            && request.resource.data.status in ['pending', 'approved', 'hidden'];
          allow delete: if hasRole(cid, 'editor');
        }
      }
      // Moderação do mural: aprovação automática e palavras bloqueadas (só a equipe vê).
      match /commentSettings/{bid} {
        allow read: if isMember(cid);
        allow write: if hasRole(cid, 'editor');
      }

      match /integrations/{iid} {
        allow read: if isMember(cid) || (isIntegration(cid) && iid == uid());
        allow create, delete: if hasRole(cid, 'admin');
        allow update: if hasRole(cid, 'admin')
          || (isIntegration(cid) && iid == uid() && changesOnly(['lastSeen', 'appVersion', 'terminal'])
              && request.resource.data.lastSeen == request.time);
      }

      // Pedidos enviados pelo GerenciaAI. Id = "{uidDaIntegração}_{idDaVenda}" (idempotente).
      match /orders/{oid} {
        function validOrder() {
          let d = request.resource.data;
          return d.keys().hasOnly(['number', 'customerName', 'status', 'unitId', 'source', 'terminal',
                                   'createdAt', 'readyAt', 'deliveredAt', 'updatedAt', 'expireAt', 'integrationUid'])
            && d.integrationUid == uid()
            && d.number is string && d.number.size() > 0 && d.number.size() <= 12
            && (d.get('customerName', null) == null || (d.customerName is string && d.customerName.size() <= 80))
            && d.status in ['preparing', 'ready', 'delivered']
            && d.get('unitId', null) == get(deviceDoc()).data.get('unitId', null);
        }
        allow read: if isMember(cid) || isAnyScreen(cid);
        allow create: if isIntegration(cid) && oid.matches(uid() + '_.+') && validOrder();
        allow update: if isIntegration(cid) && resource.data.integrationUid == uid() && validOrder();
        allow delete: if (isIntegration(cid) && resource.data.integrationUid == uid()) || hasRole(cid, 'admin');
      }
    }

    // Limite de envios do mural de comentários, por usuário anônimo: até 3 a cada 10 minutos.
    // Cada envio troca lastId (o id do comentário) e lastAt (hora do servidor) no mesmo lote.
    // Catálogo de mídia indoor: página pública /midia; só o admin da empresa publica.
    match /publicCatalogs/{cid} {
      allow get: if true;
      allow write: if hasRole(cid, 'admin');
    }

    match /commentLimits/{limitUid} {
      function okLimit() {
        let d = request.resource.data;
        return signedIn() && uid() == limitUid
          && d.keys().hasOnly(['windowStart', 'count', 'lastAt', 'lastId'])
          && d.lastAt == request.time
          && d.lastId is string && d.lastId.size() > 0 && d.lastId.size() <= 80;
      }
      allow get: if signedIn() && uid() == limitUid;
      allow create: if okLimit() && request.resource.data.windowStart == request.time && request.resource.data.count == 1;
      allow update: if okLimit() && request.resource.data.lastId != resource.data.lastId && (
          (resource.data.windowStart + duration.value(10, 'm') > request.time
            && request.resource.data.windowStart == resource.data.windowStart
            && request.resource.data.count == resource.data.count + 1
            && request.resource.data.count <= 3)
          || (resource.data.windowStart + duration.value(10, 'm') <= request.time
            && request.resource.data.windowStart == request.time
            && request.resource.data.count == 1));
    }

    // Console da Vetta: situação de todas as telas (consulta de grupo).
    match /{path=**}/screens/{sid} {
      allow list: if isVetta();
    }

    // Financeiro da Vetta: pagamentos, faturas e pedidos de todas as empresas (consultas de grupo).
    match /{path=**}/payments/{pid} {
      allow list: if isVetta();
    }
    match /{path=**}/invoices/{iid} {
      allow list: if isVetta();
    }
    match /{path=**}/storeOrders/{oid} {
      allow list: if isVetta();
    }

    // Histórico de MRR e de telas: só o servidor grava (Admin SDK); a Vetta lê.
    match /mrrEvents/{eid} {
      allow read: if isVetta();
      allow write: if false;
    }
    match /licenseEvents/{eid} {
      allow read: if isVetta();
      allow write: if false;
    }
  }
}
